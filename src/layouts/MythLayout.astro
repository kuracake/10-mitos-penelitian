---
import BaseLayout from './BaseLayout.astro';
import { site } from '../site.config';

interface Myth {
  id: string;
  data: {
    title: string;
    description: string;
    mythNumber: number;
    category: string;
    draft: boolean;
  };
}

interface Props {
  myth: Myth;
  prev?: Myth | null;
  next?: Myth | null;
}

const { myth, prev, next } = Astro.props;
const { title, description, mythNumber, category } = myth.data;

const numberLabel = String(mythNumber).padStart(2, '0');
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  article={{
    author: site.author,
  }}
>
  <main>
    <!-- ================================================= -->
    <!-- HERO -->
    <!-- ================================================= -->

    <section class="border-b-2 border-line bg-paper">
      <div class="mx-auto max-w-300 px-8 py-14 sm:py-16">
        <a
          href="/myths"
          class="inline-flex items-center gap-1 text-sm font-bold text-orange-deep transition-colors hover:text-orange"
        >
          ← Kembali ke 10 Mitos
        </a>

        <div class="mt-8 grid gap-8 lg:grid-cols-[150px_1fr] lg:items-start">
          <!-- NOMOR -->
          <div
            class="flex h-32 w-32 -rotate-2 items-center justify-center rounded-card border-2 border-ink bg-orange shadow-pop-lg sm:h-36 sm:w-36"
          >
            <span
              class="text-[4rem] font-bold leading-none tracking-tighter text-cloud sm:text-[4.5rem]"
            >
              {numberLabel}
            </span>
          </div>

          <!-- JUDUL -->
          <div class="max-w-4xl">
            <div class="flex flex-wrap items-center gap-2">
              <span
                class="inline-flex items-center rounded-chip border-2 border-ink bg-orange px-3 py-1 text-[13px] font-bold text-cloud"
              >
                Mitos {numberLabel}
              </span>

              <span
                class="inline-flex items-center rounded-chip border-2 border-ink/15 bg-orange-soft px-3 py-1 text-[13px] font-bold text-orange-deep"
              >
                {category}
              </span>
            </div>

            <h1
              class="mt-5 text-[clamp(2.5rem,5vw,4.5rem)] font-bold leading-none tracking-[-0.04em] text-ink"
            >
              {title}
            </h1>

            <p
              class="mt-6 max-w-3xl text-lg leading-relaxed text-ink/70 sm:text-xl"
            >
              {description}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================= -->
    <!-- ARTICLE -->
    <!-- ================================================= -->

    <section class="bg-paper">
      <div class="mx-auto max-w-300 px-8 py-14 sm:py-20">
        <article
          data-pagefind-body
          data-pagefind-filter="type:Myth"
          class="mx-auto max-w-205"
        >
          <!-- ARTICLE LABEL -->

          <div class="mb-10 flex items-center gap-4">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-orange"></span>

            <span
              class="text-[12px] font-bold uppercase tracking-[0.14em] text-orange-deep"
            >
              Pembahasan Mitos {numberLabel}
            </span>

            <span class="h-px flex-1 bg-line"></span>
          </div>

          <!-- ARTICLE CONTENT -->

          <div class="myth-content">
            <slot />
          </div>
        </article>
      </div>
    </section>

    <!-- ================================================= -->
    <!-- PREVIOUS / NEXT -->
    <!-- ================================================= -->

    {
      (prev || next) && (
        <section class="border-t-2 border-line bg-paper">
          <div class="mx-auto max-w-300 px-8 py-12 sm:py-16">
            <div class="mx-auto max-w-205">
              <div class="mb-7">
                <p class="text-[12px] font-bold uppercase tracking-[0.14em] text-orange-deep">
                  Lanjut Membaca
                </p>

                <h2 class="mt-2 text-2xl font-bold tracking-[-0.02em] text-ink sm:text-3xl">
                  Mitos lainnya
                </h2>
              </div>

              <nav
                class:list={[
                  'grid gap-5',
                  prev && next ? 'sm:grid-cols-2' : 'grid-cols-1',
                ]}
                aria-label="Navigasi mitos"
              >
                {prev && (
                  <a
                    href={`/myths/${prev.id}`}
                    class="group rounded-card border-2 border-ink bg-cloud p-5 shadow-pop-sm transition-[transform,box-shadow] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pop"
                  >
                    <span class="text-[11px] font-bold uppercase tracking-wider text-ink/40">
                      ← Mitos Sebelumnya
                    </span>

                    <div class="mt-3 flex items-start gap-3">
                      <span class="inline-flex h-9 min-w-9 shrink-0 items-center justify-center rounded-chip border-2 border-ink bg-orange px-2 text-xs font-bold text-cloud">
                        {String(prev.data.mythNumber).padStart(2, '0')}
                      </span>

                      <span class="font-bold leading-snug text-ink transition-colors group-hover:text-navy">
                        {prev.data.title}
                      </span>
                    </div>
                  </a>
                )}

                {next && (
                  <a
                    href={`/myths/${next.id}`}
                    class="group rounded-card border-2 border-ink bg-cloud p-5 shadow-pop-sm transition-[transform,box-shadow] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pop"
                  >
                    <span class="text-[11px] font-bold uppercase tracking-wider text-ink/40">
                      Mitos Berikutnya →
                    </span>

                    <div class="mt-3 flex items-start gap-3">
                      <span class="inline-flex h-9 min-w-9 shrink-0 items-center justify-center rounded-chip border-2 border-ink bg-orange px-2 text-xs font-bold text-cloud">
                        {String(next.data.mythNumber).padStart(2, '0')}
                      </span>

                      <span class="font-bold leading-snug text-ink transition-colors group-hover:text-navy">
                        {next.data.title}
                      </span>
                    </div>
                  </a>
                )}
              </nav>
            </div>
          </div>
        </section>
      )}
  </main>
</BaseLayout>

<style>
  /* ===================================================== */
  /* BASE */
  /* ===================================================== */

  .myth-content {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-ink);
  }

  /* ===================================================== */
  /* PARAGRAPH PEMBUKA */
  /* ===================================================== */

  .myth-content :global(> p:first-child) {
    margin-top: 0;
    margin-bottom: 2.5rem;
    padding: 1rem 0;
    border-bottom: 2px solid var(--color-line);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.7;
    color: var(--color-ink);
  }

  /* ===================================================== */
  /* MITOS & KENYATAAN */
  /* ===================================================== */

  .myth-content :global(h2) {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;

    margin-top: 3rem;
    margin-bottom: 1.25rem;

    padding: 0.85rem 1rem;

    border: 2px solid var(--color-ink);
    border-radius: var(--radius-tile);

    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .myth-content :global(h2:first-of-type) {
    margin-top: 0;
    background: var(--color-orange-soft);
    color: var(--color-orange-deep);
    box-shadow: var(--shadow-pop-sm);
  }

  .myth-content :global(h2:nth-of-type(2)) {
    background: var(--color-navy);
    color: var(--color-cloud);
    box-shadow: var(--shadow-pop-sm);
  }

  .myth-content :global(h2::before) {
    content: '';
    display: block;
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-orange);
  }

  /* ===================================================== */
  /* TEXT SETELAH MITOS / KENYATAAN */
  /* ===================================================== */

  .myth-content :global(h2 + p) {
    margin-top: 0;
  }

  /* ===================================================== */
  /* SUB HEADING 1.1 / 1.2 / 4.1 / 4.2 */
  /* ===================================================== */

  .myth-content :global(h3) {
    position: relative;

    margin-top: 3.5rem;
    margin-bottom: 1.25rem;

    padding: 1rem 1.25rem;

    border: 2px solid var(--color-ink);
    border-radius: var(--radius-tile);

    background: var(--color-cloud);

    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.55rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;

    color: var(--color-navy);

    box-shadow: var(--shadow-pop-sm);
  }

  .myth-content :global(h3::before) {
    content: '';
    display: block;
    margin-bottom: 0.35rem;

    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;

    color: var(--color-orange-deep);
  }

  /* ===================================================== */
  /* PARAGRAPH */
  /* ===================================================== */

  .myth-content :global(p) {
    margin-top: 1.2rem;
  }

  .myth-content :global(h3 + p) {
    margin-top: 0;
  }

  /* ===================================================== */
  /* LIST */
  /* ===================================================== */

  .myth-content :global(ul),
  .myth-content :global(ol) {
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;

    padding: 1rem 1.25rem 1rem 2.4rem;

    border: 2px solid var(--color-line);
    border-radius: var(--radius-tile);

    background: var(--color-cloud);
  }

  .myth-content :global(li) {
    margin-top: 0.45rem;
    padding-left: 0.2rem;
  }

  .myth-content :global(li:first-child) {
    margin-top: 0;
  }

  .myth-content :global(ul li::marker) {
    color: var(--color-orange);
    font-size: 1.1em;
  }

  /* ===================================================== */
  /* STRONG */
  /* ===================================================== */

  .myth-content :global(strong) {
    font-weight: 700;
    color: var(--color-navy);
  }

  /* ===================================================== */
  /* BLOCKQUOTE / CONTOH */
  /* ===================================================== */

  .myth-content :global(blockquote) {
    margin: 1.75rem 0;

    padding: 1.25rem 1.5rem;

    border: 2px solid var(--color-ink);
    border-left: 6px solid var(--color-orange);

    border-radius: var(--radius-tile);

    background: var(--color-orange-soft);

    box-shadow: var(--shadow-pop-sm);

    font-weight: 600;
    color: var(--color-ink);
  }

  /* ===================================================== */
  /* CODE BLOCK */
  /* ===================================================== */

  .myth-content :global(pre) {
    position: relative;

    margin: 2rem 0;

    overflow-x: auto;

    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);

    padding: 3.1rem 1.5rem 1.5rem;

    background: #24282d;
    color: #ffffff;

    box-shadow: var(--shadow-pop);
  }

  .myth-content :global(pre::before) {
    content: 'RESEARCH FLOW';

    position: absolute;
    top: 0;
    left: 0;
    right: 0;

    padding: 0.65rem 1rem;

    border-bottom: 1px solid rgb(255 255 255 / 0.12);

    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;

    color: var(--color-orange-glow);
  }

  .myth-content :global(code) {
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      'Liberation Mono',
      'Courier New',
      monospace;

    font-size: 0.88em;
  }

  /* ===================================================== */
  /* INLINE CODE */
  /* ===================================================== */

  .myth-content :global(p code),
  .myth-content :global(li code) {
    border: 1px solid var(--color-orange-glow);

    border-radius: 6px;

    padding: 0.15em 0.4em;

    background: var(--color-orange-soft);
    color: var(--color-orange-deep);

    font-size: 0.9em;
    font-weight: 700;
  }

  /* ===================================================== */
  /* LINKS */
  /* ===================================================== */

  .myth-content :global(a) {
    color: var(--color-orange-deep);
    font-weight: 700;

    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* ===================================================== */
  /* DIVIDER */
  /* ===================================================== */

  .myth-content :global(hr) {
    margin: 3rem 0;

    border: 0;
    border-top: 2px dashed var(--color-line);
  }

  /* ===================================================== */
  /* TABLE */
  /* ===================================================== */

  .myth-content :global(table) {
    display: block;

    width: 100%;

    margin: 2rem 0;

    overflow-x: auto;

    border: 2px solid var(--color-ink);
    border-radius: var(--radius-tile);

    background: var(--color-cloud);

    box-shadow: var(--shadow-pop-sm);
  }

  .myth-content :global(th) {
    background: var(--color-navy);
    color: var(--color-cloud);
    font-weight: 700;
  }

  .myth-content :global(th),
  .myth-content :global(td) {
    padding: 0.8rem 1rem;

    text-align: left;

    border-bottom: 1px solid var(--color-line);
  }

  /* ===================================================== */
  /* MOBILE */
  /* ===================================================== */

  @media (max-width: 640px) {
    .myth-content {
      font-size: 1rem;
      line-height: 1.8;
    }

    .myth-content :global(> p:first-child) {
      padding: 0.9rem 0;
      font-size: 0.95rem;
    }

    .myth-content :global(h2) {
      margin-top: 2.5rem;
      padding: 0.8rem 0.9rem;
    }

    .myth-content :global(h3) {
      margin-top: 2.5rem;
      padding: 0.9rem 1rem;
    }

    .myth-content :global(ul),
    .myth-content :global(ol) {
      padding-left: 2rem;
    }

    .myth-content :global(pre) {
      padding: 3rem 1rem 1rem;
      box-shadow: var(--shadow-pop-sm);
    }
  }
</style>