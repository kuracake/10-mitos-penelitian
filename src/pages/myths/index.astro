---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/blog/PageBanner.astro';
import TagPill from '../../components/blog/TagPill.astro';

const myths = await getCollection('myths');

const publishedMyths = myths
	.filter((myth) => !myth.data.draft)
	.sort((a, b) => a.data.mythNumber - b.data.mythNumber);
---

<BaseLayout
	title="10 Mitos Penelitian di Bidang Komputasi"
	description="Pelajari 10 mitos penelitian di bidang komputasi dan pahami bagaimana penelitian seharusnya dilakukan."
>
	<main>

		<!-- ========================================= -->
		<!-- PAGE BANNER -->
		<!-- ========================================= -->

		<PageBanner
			eyebrow="Materi Penelitian"
			title="10 Mitos Penelitian di Bidang Komputasi"
			sub="Pelajari berbagai kesalahpahaman yang sering muncul dalam penelitian bidang komputasi dan pahami bagaimana penelitian seharusnya dilakukan."
		/>


		<!-- ========================================= -->
		<!-- MYTH GRID -->
		<!-- ========================================= -->

		<section>
			<div class="mx-auto max-w-300 px-8 py-16">

				<div class="mb-10 flex items-end justify-between gap-6">
					<div>
						<p class="text-[13px] font-bold uppercase tracking-[0.12em] text-orange-deep">
							Daftar Materi
						</p>

						<h2 class="mt-2 text-3xl font-bold tracking-[-0.02em] text-ink">
							10 Mitos yang Perlu Dipahami
						</h2>
					</div>

					<p class="hidden text-sm font-semibold text-ink/50 sm:block">
						{publishedMyths.length} materi
					</p>
				</div>


				<div class="grid gap-8 md:grid-cols-2">

					{publishedMyths.map((myth, index) => (
						<article
							class:list={[
								'group relative flex flex-col rounded-card border-2 border-ink bg-cloud p-6 shadow-pop transition-[transform,box-shadow] duration-200 hover:rotate-0 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pop-lg',
								index % 2 === 0
									? 'rotate-[-1.5deg]'
									: 'rotate-[1.5deg]',
							]}
						>

							<!-- Myth number + category -->

							<div class="relative z-10 mb-4 flex flex-wrap items-center justify-between gap-2">

								<span
									class="inline-flex items-center rounded-chip border-2 border-ink bg-orange px-3 py-1 text-[13px] font-bold text-cloud"
								>
									Mitos {String(myth.data.mythNumber).padStart(2, '0')}
								</span>

								<TagPill
									name={myth.data.category}
									link={false}
								/>

							</div>


							<!-- Title -->

							<h3 class="text-[22px] font-bold leading-tight tracking-[-0.02em] text-ink">

								<a
									href={`/myths/${myth.id}`}
									class="after:absolute after:inset-0 group-hover:text-navy"
								>
									{myth.data.title}
								</a>

							</h3>


							<!-- Description -->

							<p class="mt-3 text-[15px] leading-relaxed text-ink/75">
								{myth.data.description}
							</p>


							<!-- Read more -->

							<span class="mt-5 inline-flex items-center gap-1 text-[15px] font-bold text-orange-deep">

								Baca materi

								<span
									class="transition-transform group-hover:translate-x-1"
									aria-hidden="true"
								>
									→
								</span>

							</span>

						</article>
					))}

				</div>

			</div>
		</section>


		<!-- ========================================= -->
		<!-- BOTTOM CTA -->
		<!-- ========================================= -->

		<section class="border-t-2 border-line bg-paper">

			<div class="mx-auto max-w-300 px-8 py-16">

				<div class="rounded-card border-2 border-ink bg-navy p-8 shadow-pop sm:p-10">

					<div class="max-w-3xl">

						<p class="text-[13px] font-bold uppercase tracking-[0.12em] text-orange-glow">
							Lanjut Belajar
						</p>

						<h2 class="mt-3 text-3xl font-bold tracking-[-0.02em] text-cloud sm:text-4xl">
							Pahami proses penelitian dari awal hingga publikasi.
						</h2>

						<p class="mt-4 text-base leading-relaxed text-cloud/70">
							Setelah memahami berbagai mitos penelitian, lanjutkan ke
							research roadmap untuk melihat bagaimana sebuah penelitian
							dibangun secara bertahap.
						</p>

						<div class="mt-7">

							<a
								href="/roadmap"
								class="inline-flex items-center rounded-full border-2 border-ink bg-orange px-5 py-2.5 text-sm font-bold text-cloud shadow-pop-sm transition-[transform,box-shadow] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pop"
							>
								Lihat Research Roadmap
								<span class="ml-1">→</span>
							</a>

						</div>

					</div>

				</div>

			</div>

		</section>

	</main>
</BaseLayout>